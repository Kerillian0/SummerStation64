# Ignore editor specific config folders/files
/.vscode

# Ignore compilation result directories
/build
/output
/docs/api
/_site

# Ignore generated files in the libdragon FS
/filesystem/Firple-Bold.font64
/filesystem/Firple-Bold-Latin.font64
/filesystem/Firple-Bold-Title.font64
/filesystem/Firple-Bold-Title20.font64
/filesystem/FiraMonoBold.font64
/filesystem/*.wav64
/filesystem/*.sprite

# Box art the user bakes into their own build (see assets/boxart/README.md)
/filesystem/art/
/assets/boxart/source/

# Ignore external development tools
/tools/*

# Ignore any N64 ROM
**/*.n64
**/*.v64
**/*.z64

# Ignore exe files
*.exe

# Ignore macOS filesystem cruft
.DS_Store
